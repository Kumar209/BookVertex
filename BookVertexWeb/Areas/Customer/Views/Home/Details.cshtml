@model ShoppingCart

<div class="bg-base-200">
    <div class="mx-auto w-full max-w-7xl px-4 py-3 sm:px-6 lg:px-8 lg:py-4">
        <div class="mb-3">
            <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-semibold text-base-content/60 transition hover:text-primary">
                <i class="bi bi-arrow-left"></i> Back to all books
            </a>
        </div>

        <form method="post">
            <input hidden asp-for="ProductId" />

            <div class="overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm">
                <div class="grid lg:grid-cols-[430px_1fr]">

                    <!-- Image -->
                    <div class="relative h-[430px] overflow-hidden bg-base-300 lg:h-[520px]">
                        @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                        {
                            <img src="@Model.Product.ImageUrl" alt="@Model.Product.Title" class="absolute inset-0 h-full w-full object-cover" />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent"></div>
                        }
                        else
                        {
                            <div class="flex h-full flex-col items-center justify-center text-base-content/30">
                                <div class="flex h-20 w-20 items-center justify-center rounded-2xl bg-base-100/50">
                                    <i class="bi bi-book text-5xl"></i>
                                </div>
                                <p class="mt-3 text-sm font-medium">No Image Available</p>
                            </div>
                        }

                        <div class="absolute left-4 top-4">
                            <span class="badge badge-primary gap-1 border-0 px-3 py-3 shadow-lg">
                                <i class="bi bi-bookmark-fill"></i> @Model.Product.Category?.Name
                            </span>
                        </div>
                    </div>

                    <!-- Details -->
                    <div class="flex flex-col p-5 sm:p-6 lg:p-7">
                        <div class="grid gap-4 lg:grid-cols-[1fr_auto] lg:items-start">
                            <div class="min-w-0">
                                <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary">BookVertex Collection</p>
                                <h1 class="mt-1.5 text-2xl font-extrabold leading-tight tracking-tight text-base-content sm:text-3xl">@Model.Product.Title</h1>
                                <p class="mt-1.5 text-sm text-base-content/60">
                                    by <span class="font-semibold text-base-content">@Model.Product.Author</span>
                                </p>
                                <p class="mt-1.5 flex items-center gap-2 text-xs text-base-content/40">
                                    <i class="bi bi-upc-scan"></i>
                                    ISBN:
                                    <span class="font-medium text-base-content/60">@Model.Product.ISBN</span>
                                </p>
                            </div>

                            <div class="lg:pt-1 lg:text-right">
                                <p class="text-[10px] font-bold uppercase tracking-wider text-base-content/50">Current Price</p>
                                <div class="mt-0.5 flex items-baseline gap-2 lg:justify-end">
                                    <span class="text-4xl font-black tracking-tight text-primary">@Model.Price.ToString("c")</span>
                                    @if (Model.Product.ListPrice > Model.Price)
                                    {
                                        <span class="text-sm text-base-content/40 line-through">@Model.Product.ListPrice.ToString("c")</span>
                                    }
                                </div>
                                @if (Model.Product.ListPrice > Model.Price)
                                {
                                    <p class="mt-0.5 text-[10px] font-semibold text-success">
                                        <i class="bi bi-tag-fill"></i> Great value
                                    </p>
                                }
                            </div>
                        </div>

                        <!-- Volume Discounts -->
                        <div class="mt-5">
                            <div class="mb-2 flex items-center justify-between">
                                <div>
                                    <h2 class="text-xs font-bold text-base-content">Volume Discounts</h2>
                                    <p class="text-[10px] text-base-content/50">Save more with larger quantities.</p>
                                </div>
                                <i class="bi bi-stack text-base text-base-content/40"></i>
                            </div>

                            <div class="grid grid-cols-3 gap-2">
                                <div class="rounded-lg border border-base-300 bg-base-200/60 p-2.5 text-center">
                                    <p class="text-[9px] font-bold uppercase tracking-wide text-base-content/50">1-50 Units</p>
                                    <p class="mt-1 text-sm font-bold text-base-content">@Model.Product.Price.ToString("c")</p>
                                </div>

                                <div class="rounded-lg border border-success/30 bg-success/5 p-2.5 text-center">
                                    <p class="text-[9px] font-bold uppercase tracking-wide text-base-content/60">51-100 Units</p>
                                    <p class="mt-1 text-sm font-bold text-success">@Model.Product.Price50.ToString("c")</p>
                                    <span class="mt-0.5 inline-block text-[8px] font-bold uppercase text-success">SAVE</span>
                                </div>

                                <div class="rounded-lg border border-secondary/40 bg-secondary/5 p-2.5 text-center">
                                    <p class="text-[9px] font-bold uppercase tracking-wide text-base-content/60">100+ Units</p>
                                    <p class="mt-1 text-sm font-bold text-secondary">@Model.Product.Price100.ToString("c")</p>
                                    <span class="mt-0.5 inline-block text-[8px] font-bold uppercase text-secondary">BEST VALUE</span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-5 border-t border-base-300 pt-4">
                            <h2 class="text-xs font-bold uppercase tracking-wider text-base-content/70">About this book</h2>
                            <div class="prose prose-sm mt-1.5 max-w-none text-xs leading-5 text-base-content/70">
                                @Html.Raw(Model.Product.Description)
                            </div>
                        </div>

                        <div class="mt-auto pt-5">
                            <div class="flex flex-col gap-2.5 sm:flex-row">
                                <label class="input input-bordered flex !h-11 !min-h-11 w-full items-center border-base-300 focus-within:border-primary focus-within:outline-none focus-within:ring-0 sm:w-32">
                                    <span class="text-xs font-bold text-base-content/50">Qty</span>
                                    <input asp-for="Count" type="number" min="1" class="grow border-0 bg-transparent text-center text-sm font-bold outline-none focus:border-0 focus:outline-none focus:ring-0" />
                                </label>

                                <button type="submit" class="btn btn-primary !h-11 !min-h-11 flex-1 gap-2 text-sm font-bold shadow-lg shadow-primary/20">
                                    <i class="bi bi-cart-plus"></i> Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </form>
    </div>
</div>