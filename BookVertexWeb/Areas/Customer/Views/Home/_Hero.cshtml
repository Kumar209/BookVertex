<section class="relative overflow-hidden bg-base-100">

    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_78%_48%,color-mix(in_srgb,var(--color-primary)_10%,transparent)_0%,color-mix(in_srgb,var(--color-primary)_4%,transparent)_32%,transparent_62%)]"></div>

    <div class="relative mx-auto flex min-h-[calc(100vh-80px)] w-full max-w-7xl items-center px-4 py-8 sm:px-6 lg:px-8 lg:py-10">

        <div class="grid w-full items-center gap-8 lg:grid-cols-2 lg:gap-10">

            <div class="text-center lg:text-left">

                <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-4 py-2 text-[11px] font-bold uppercase tracking-[0.2em] text-primary">
                    <i class="bi bi-stars"></i>
                    Editor's Pick
                </p>

                <h1 class="text-5xl font-black leading-[0.95] tracking-[-0.04em] text-base-content sm:text-6xl lg:text-[4.2rem]">
                    Stories that <span class="text-primary">stay</span>
                    <br />
                    with you
                    <br />
                    forever.
                </h1>

                <p class="mx-auto mt-5 max-w-xl text-base leading-7 text-base-content/60 sm:text-lg lg:mx-0">
                    Curated collections, bestselling authors, and hidden gems — all in one place.
                    Start your next chapter today.
                </p>

                <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row lg:justify-start">

                    <a href="#catalog" class="btn btn-primary h-12 px-6 text-sm font-bold shadow-lg shadow-primary/20">
                        Explore the Collection
                        <i class="bi bi-arrow-right"></i>
                    </a>

                    <a href="#catalog" class="btn btn-outline h-12 border-base-content/30 px-6 text-sm font-semibold">
                        <i class="bi bi-compass"></i>
                        Browse by Category
                    </a>

                </div>

                <div class="mx-auto mt-8 grid max-w-xl grid-cols-3 border-t border-base-300 pt-5 lg:mx-0">

                    <div class="text-center lg:text-left">
                        <p class="text-2xl font-black text-base-content sm:text-3xl">
                            @Model.Count+
                        </p>

                        <p class="mt-1 text-[10px] font-bold uppercase tracking-[0.15em] text-base-content/40">
                            Book Titles
                        </p>
                    </div>

                    <div class="border-l border-base-300 text-center">
                        <p class="text-2xl font-black text-base-content sm:text-3xl">
                            12
                        </p>

                        <p class="mt-1 text-[10px] font-bold uppercase tracking-[0.15em] text-base-content/40">
                            Categories
                        </p>
                    </div>

                    <div class="border-l border-base-300 text-center">
                        <p class="text-2xl font-black text-base-content sm:text-3xl">
                            4.9 <i class="bi bi-star-fill text-sm text-primary"></i>
                        </p>

                        <p class="mt-1 text-[10px] font-bold uppercase tracking-[0.15em] text-base-content/40">
                            Avg Rating
                        </p>
                    </div>

                </div>

            </div>

            <div class="relative hidden h-[440px] items-center justify-center lg:flex">

                <div class="absolute h-[330px] w-[330px] rounded-full border border-primary/10"></div>

                <div class="absolute h-[260px] w-[260px] rounded-full border border-primary/10"></div>

                <div class="absolute left-[8%] top-[24%] h-[235px] w-[155px] -rotate-[9deg] overflow-hidden rounded-2xl border border-base-300 bg-base-200/70 opacity-70 shadow-lg">

                    <div class="flex h-full items-center justify-center text-base-content/20">
                        <i class="bi bi-book text-6xl"></i>
                    </div>

                </div>

                <div class="relative z-10 h-[335px] w-[235px] overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-2xl shadow-primary/10">

                    <div class="flex h-full flex-col items-center justify-center bg-gradient-to-br from-primary/10 via-base-100 to-primary/5">

                        <div class="flex h-24 w-24 items-center justify-center rounded-2xl bg-primary text-primary-content shadow-lg shadow-primary/25">
                            <i class="bi bi-book text-5xl"></i>
                        </div>

                        <p class="mt-6 text-xs font-bold uppercase tracking-[0.35em] text-base-content/50">
                            BookVertex
                        </p>

                    </div>

                </div>

                <div class="absolute right-[8%] top-[24%] h-[235px] w-[155px] rotate-[9deg] overflow-hidden rounded-2xl border border-base-300 bg-base-200/70 opacity-70 shadow-lg">

                    <div class="flex h-full items-center justify-center text-base-content/20">
                        <i class="bi bi-journal-bookmark text-6xl"></i>
                    </div>

                </div>

                <div class="absolute right-[10%] top-[12%] z-20 rounded-2xl border border-base-300 bg-base-100 px-4 py-3 shadow-xl">

                    <p class="text-[9px] font-bold uppercase tracking-wider text-base-content/50">
                        Save up to
                    </p>

                    <p class="text-xl font-black text-primary">
                        50%
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>