<!-- Newsletter Section -->
<section class="relative overflow-hidden bg-base-100 py-12 sm:py-16 lg:py-20">

    <div class="absolute inset-0 pointer-events-none">
        <div class="absolute -left-32 top-10 h-72 w-72 rounded-full bg-primary/10 blur-3xl"></div>
        <div class="absolute -right-32 bottom-0 h-72 w-72 rounded-full bg-info/10 blur-3xl"></div>
    </div>

    <div class="relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">

        <div class="overflow-hidden rounded-3xl border border-base-300 bg-base-200/60 shadow-sm">

            <div class="p-6 sm:p-8 lg:p-10">

                <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:gap-10">

                    <div class="flex shrink-0 items-center justify-center lg:justify-start">

                        <div class="flex h-20 w-20 items-center justify-center rounded-2xl bg-primary text-primary-content shadow-lg shadow-primary/20">

                            <i class="bi bi-envelope-heart text-4xl"></i>

                        </div>

                    </div>

                    <div class="min-w-0 flex-1">

                        <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary">
                            Stay Updated
                        </p>

                        <h2 class="mt-2 text-2xl font-black tracking-tight text-base-content sm:text-3xl">
                            Never miss a good story.
                        </h2>

                        <p class="mt-2 max-w-2xl text-sm leading-6 text-base-content/60 sm:text-base">
                            Subscribe for special offers, new arrivals, giveaways, and exclusive deals.
                        </p>

                    </div>

                </div>

                <!-- TODO: Add form method and action attributes -->
                <form class="mt-7 flex flex-col gap-3 sm:flex-row">

                    <label class="input !h-12 !min-h-12 w-full flex-1 items-center gap-3 border border-base-300 bg-base-100 px-4 shadow-none outline-none focus-within:border-primary focus-within:outline-none focus-within:ring-2 focus-within:ring-primary/20">

                        <i class="bi bi-envelope text-base-content/30"></i>

                        <input type="email"
                               name="email"
                               placeholder="Your email address"
                               class="h-full min-h-0 grow border-0 bg-transparent p-0 text-sm outline-none focus:border-0 focus:outline-none focus:ring-0"
                               required />

                    </label>

                    <button type="submit"
                            class="btn btn-primary !h-12 !min-h-12 w-full gap-2 px-6 font-bold shadow-lg shadow-primary/20 sm:w-auto">

                        Subscribe

                        <i class="bi bi-arrow-right"></i>

                    </button>

                </form>

                <p class="mt-3 flex items-center gap-1.5 text-xs text-base-content/40">

                    <i class="bi bi-shield-check"></i>

                    We respect your privacy

                </p>

            </div>

        </div>

    </div>

</section>