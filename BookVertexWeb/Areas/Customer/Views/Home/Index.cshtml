@model IEnumerable<Product>

<partial name="_Hero" />

<section id="catalog" class="bg-base-200/50 py-9 sm:py-10 lg:py-12">

    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">

        <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">

            <div>

                <p class="mb-1.5 flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.2em] text-primary">
                    <span class="h-1 w-8 rounded-full bg-primary"></span>
                    Our Collection
                </p>

                <h2 class="text-3xl font-black tracking-tight text-base-content sm:text-4xl">
                    Explore our <span class="text-primary">collection.</span>
                </h2>

                <p class="mt-1.5 text-sm text-base-content/60 sm:text-base">
                    Discover bestselling authors, timeless classics, and hidden gems.
                </p>

            </div>

            <div class="badge badge-outline h-9 gap-2 px-4 text-sm">
                <i class="bi bi-book text-primary"></i>
                @Model.Count() books
            </div>

        </div>

        <!-- Books Grid -->
        @if (Model.Any())
        {
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">

                @foreach (var product in Model)
                {
                    <div class="group overflow-hidden rounded-xl border border-base-300 bg-base-100 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">

                        <a asp-action="Details"
                           asp-route-productId="@product.Id"
                           class="block">

                            <div class="relative h-[280px] overflow-hidden bg-base-200">

                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.Title"
                                         class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                                }
                                else
                                {
                                    <div class="flex h-full w-full items-center justify-center bg-base-200 text-base-content/20">
                                        <i class="bi bi-book text-6xl"></i>
                                    </div>
                                }

                                <div class="absolute left-3 top-3">
                                    <span class="badge badge-primary border-0 px-3 py-3 text-xs shadow-md">
                                        @product.Category?.Name
                                    </span>
                                </div>

                            </div>

                        </a>

                        <div class="p-3.5">

                            <div class="mb-1.5 flex items-center gap-2 text-[11px] text-base-content/40">
                                <i class="bi bi-bookmark"></i>
                                <span>@product.Category?.Name</span>
                            </div>

                            <h3 class="line-clamp-1 text-base font-black text-base-content">
                                @product.Title
                            </h3>

                            <p class="mt-0.5 line-clamp-1 text-sm text-base-content/55">
                                by @product.Author
                            </p>

                            <div class="mt-3 flex items-center justify-between gap-2 border-t border-base-300 pt-3">

                                <div class="min-w-0">

                                    <div class="flex items-baseline gap-1.5">

                                        <span class="text-lg font-black text-primary">
                                            @product.Price100.ToString("c")
                                        </span>

                                        @if (product.ListPrice > product.Price100)
                                        {
                                            <span class="text-[11px] text-base-content/40 line-through">
                                                @product.ListPrice.ToString("c")
                                            </span>
                                        }

                                    </div>

                                    <p class="mt-0.5 text-[9px] font-medium text-base-content/40">
                                        100+ units
                                    </p>

                                </div>

                                <a asp-action="Details"
                                   asp-route-productId="@product.Id"
                                   class="btn btn-primary btn-sm h-9 min-h-9 gap-1 px-3 text-xs">

                                    View
                                    <i class="bi bi-arrow-right"></i>

                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="rounded-2xl border border-base-300 bg-base-100 py-16 text-center">

                <i class="bi bi-book text-5xl text-base-content/20"></i>

                <h3 class="mt-4 text-xl font-bold">
                    No books available
                </h3>

                <p class="mt-2 text-sm text-base-content/50">
                    Check back later for new additions to our collection.
                </p>

            </div>
        }

    </div>

</section>

<partial name="_Newsletter" />