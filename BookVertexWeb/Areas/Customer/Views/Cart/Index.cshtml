@model ShoppingCartVM

@{
    var itemCount = Model.ShoppingCartList.Count();
}

<div class="min-h-[calc(100vh-68px)] bg-base-200 px-3 py-5 sm:px-6 sm:py-7 lg:px-8">
    <div class="mx-auto w-full max-w-6xl">

        <!-- Header -->
        <div class="mb-5 flex items-center justify-between gap-3">
            <div>
                <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary">
                    Shopping Cart
                </p>

                <h1 class="mt-1 font-serif text-2xl font-bold tracking-tight text-base-content sm:text-3xl">
                    Your Cart
                </h1>

                <p class="mt-1 text-xs text-base-content/55 sm:text-sm">
                    Review your items before placing your order.
                </p>
            </div>

            <a asp-area="Customer"
               asp-controller="Home"
               asp-action="Index"
               class="btn btn-ghost btn-sm hidden gap-2 sm:inline-flex">
                <i class="bi bi-arrow-left"></i>
                Continue Shopping
            </a>
        </div>

        <!-- Mobile Continue Shopping -->
        <div class="mb-4 sm:hidden">
            <a asp-area="Customer"
               asp-controller="Home"
               asp-action="Index"
               class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary">
                <i class="bi bi-arrow-left"></i>
                Continue Shopping
            </a>
        </div>

        <form method="post">

            <div class="grid grid-cols-1 items-start gap-5 lg:grid-cols-[minmax(0,1fr)_380px]">

                <!-- ================= CART ITEMS ================= -->
                <section class="overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm">

                    <!-- Header -->
                    <div class="flex items-center justify-between border-b border-base-300 px-4 py-4 sm:px-5">

                        <div class="flex items-center gap-3">

                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                                <i class="bi bi-bag text-lg"></i>
                            </div>

                            <div>
                                <h2 class="text-sm font-bold text-base-content sm:text-base">
                                    Your Items
                                </h2>

                                <p class="text-[11px] text-base-content/50">
                                    @itemCount @(itemCount == 1 ? "item" : "items") in your cart
                                </p>
                            </div>

                        </div>

                        <span class="badge badge-primary badge-sm font-bold">
                            @itemCount
                        </span>

                    </div>

                    @if (itemCount == 0)
                    {
                        <!-- Empty Cart -->
                        <div class="flex flex-col items-center justify-center px-5 py-16 text-center">

                            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-base-200 text-base-content/35">
                                <i class="bi bi-cart-x text-3xl"></i>
                            </div>

                            <h3 class="mt-4 text-base font-bold text-base-content">
                                Your cart is empty
                            </h3>

                            <p class="mt-1 max-w-xs text-xs text-base-content/50">
                                Looks like you haven't added any books yet.
                            </p>

                            <a asp-area="Customer"
                               asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-primary btn-sm mt-5 gap-2">
                                <i class="bi bi-book"></i>
                                Explore Books
                            </a>

                        </div>
                    }
                    else
                    {
                        <!-- Cart Items -->
                        <div class="divide-y divide-base-300">

                            @foreach (var item in Model.ShoppingCartList)
                            {
                                <div class="flex gap-3 px-4 py-4 sm:px-5">

                                    <!-- Book Image -->
                                    <div class="h-[78px] w-[58px] shrink-0 overflow-hidden rounded-lg border border-base-300 bg-base-200">

                                        @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                        {
                                            <img src="@item.Product.ImageUrl"
                                                 alt="@item.Product.Title"
                                                 class="h-full w-full object-cover" />
                                        }
                                        else
                                        {
                                            <div class="flex h-full w-full items-center justify-center text-base-content/30">
                                                <i class="bi bi-book text-xl"></i>
                                            </div>
                                        }

                                    </div>

                                    <!-- Product Information -->
                                    <div class="min-w-0 flex-1">

                                        <h3 class="truncate text-sm font-bold text-base-content">
                                            @item.Product.Title
                                        </h3>

                                        <p class="mt-0.5 truncate text-[11px] text-base-content/50">
                                            by @item.Product.Author
                                        </p>

                                        <p class="mt-1 text-xs font-semibold text-primary">
                                            @item.Price.ToString("c") each
                                        </p>

                                        <!-- Quantity -->
                                        <div class="mt-3 inline-flex items-center overflow-hidden rounded-lg border border-base-300 bg-base-100">

                                            <a asp-action="minus"
                                               asp-route-cartId="@item.Id"
                                               class="flex h-8 w-8 items-center justify-center text-base-content/60 transition hover:bg-base-200 hover:text-base-content">
                                                <i class="bi bi-dash"></i>
                                            </a>

                                            <input type="number"
                                                   value="@item.Count"
                                                   min="1"
                                                   class="h-8 w-10 border-x border-base-300 bg-transparent text-center text-xs font-bold text-base-content outline-none"
                                                   onchange="updateCart(@item.Id, this.value)" />

                                            <a asp-action="plus"
                                               asp-route-cartId="@item.Id"
                                               class="flex h-8 w-8 items-center justify-center text-primary transition hover:bg-primary/10">
                                                <i class="bi bi-plus-lg"></i>
                                            </a>

                                        </div>

                                    </div>

                                    <!-- Price / Remove -->
                                    <div class="flex shrink-0 flex-col items-end justify-between">

                                        <span class="text-sm font-bold text-base-content">
                                            @((item.Price * item.Count).ToString("c"))
                                        </span>

                                        <a asp-action="Remove"
                                           asp-route-cartId="@item.Id"
                                           class="inline-flex items-center gap-1 text-[11px] font-semibold text-error/75 transition hover:text-error">

                                            <i class="bi bi-trash3"></i>

                                            <span class="hidden sm:inline">
                                                Remove
                                            </span>

                                        </a>

                                    </div>

                                </div>
                            }

                        </div>

                        <!-- Continue Shopping -->
                        <div class="border-t border-base-300 bg-base-200/40 px-4 py-3 sm:px-5">

                            <a asp-area="Customer"
                               asp-controller="Home"
                               asp-action="Index"
                               class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary transition hover:opacity-70">

                                <i class="bi bi-arrow-left"></i>
                                Continue Shopping

                            </a>

                        </div>
                    }

                </section>


                <!-- ================= CHECKOUT ================= -->
                <aside class="lg:sticky lg:top-[84px]">

                    <div class="overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm">

                        <!-- ================= DELIVERY INFORMATION ================= -->
                        <div class="border-b border-base-300 px-4 py-5 sm:px-5">

                            <!-- Section Header -->
                            <div class="mb-4 flex items-center gap-3">

                                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 text-primary">
                                    <i class="bi bi-person-lines-fill"></i>
                                </div>

                                <div>
                                    <h2 class="text-sm font-bold text-base-content">
                                        Delivery Information
                                    </h2>

                                    <p class="text-[10px] text-base-content/50">
                                        Where should we deliver your order?
                                    </p>
                                </div>

                            </div>


                            <!-- Name / Phone -->
                            <div class="grid grid-cols-2 gap-2.5">

                                <!-- Name -->
                                <div class="flex flex-col gap-1.5">

                                    <label asp-for="OrderHeader.Name"
                                           class="text-[11px] font-semibold text-base-content/75">
                                    </label>

                                    <input asp-for="OrderHeader.Name"
                                           class="input input-bordered input-sm w-full bg-base-100 text-xs focus:border-primary focus:outline-none"
                                           placeholder="Enter your name" />

                                    <span asp-validation-for="OrderHeader.Name"
                                          class="text-[10px] text-error">
                                    </span>

                                </div>


                                <!-- Phone -->
                                <div class="flex flex-col gap-1.5">

                                    <label asp-for="OrderHeader.PhoneNumber"
                                           class="text-[11px] font-semibold text-base-content/75">
                                    </label>

                                    <input asp-for="OrderHeader.PhoneNumber"
                                           class="input input-bordered input-sm w-full bg-base-100 text-xs focus:border-primary focus:outline-none"
                                           placeholder="Enter phone number" />

                                    <span asp-validation-for="OrderHeader.PhoneNumber"
                                          class="text-[10px] text-error">
                                    </span>

                                </div>

                            </div>


                            <!-- Shipping Address Header -->
                            <div class="mt-5 flex items-center gap-2">

                                <i class="bi bi-geo-alt text-primary"></i>

                                <h3 class="text-xs font-bold text-base-content">
                                    Shipping Address
                                </h3>

                            </div>


                            <!-- Address Fields -->
                            <div class="mt-3 flex flex-col gap-2.5">

                                <!-- Street Address -->
                                <div class="flex flex-col gap-1.5">

                                    <label asp-for="OrderHeader.StreetAddress"
                                           class="text-[11px] font-semibold text-base-content/75">
                                    </label>

                                    <input asp-for="OrderHeader.StreetAddress"
                                           class="input input-bordered input-sm w-full bg-base-100 text-xs focus:border-primary focus:outline-none"
                                           placeholder="Enter street address" />

                                    <span asp-validation-for="OrderHeader.StreetAddress"
                                          class="text-[10px] text-error">
                                    </span>

                                </div>


                                <!-- City / State -->
                                <div class="grid grid-cols-3 gap-2.5">

                                    <!-- City -->
                                    <div class="col-span-2 flex flex-col gap-1.5">

                                        <label asp-for="OrderHeader.City"
                                               class="text-[11px] font-semibold text-base-content/75">
                                        </label>

                                        <input asp-for="OrderHeader.City"
                                               class="input input-bordered input-sm w-full bg-base-100 text-xs focus:border-primary focus:outline-none"
                                               placeholder="City" />

                                        <span asp-validation-for="OrderHeader.City"
                                              class="text-[10px] text-error">
                                        </span>

                                    </div>

                                    <!-- State -->
                                    <div class="col-span-1 flex flex-col gap-1.5">

                                        <label asp-for="OrderHeader.State"
                                               class="text-[11px] font-semibold text-base-content/75">
                                        </label>

                                        <input asp-for="OrderHeader.State"
                                               class="input input-bordered input-sm w-full bg-base-100 text-xs uppercase focus:border-primary focus:outline-none"
                                               placeholder="State" />

                                        <span asp-validation-for="OrderHeader.State"
                                              class="text-[10px] text-error">
                                        </span>

                                    </div>

                                </div>

                                <!-- Postal Code -->
                                <div class="mt-2.5 flex flex-col gap-1.5">

                                    <label asp-for="OrderHeader.PostalCode"
                                           class="text-[11px] font-semibold text-base-content/75">
                                    </label>

                                    <input asp-for="OrderHeader.PostalCode"
                                           class="input input-bordered input-sm w-full bg-base-100 text-xs focus:border-primary focus:outline-none"
                                           placeholder="ZIP Code" />

                                    <span asp-validation-for="OrderHeader.PostalCode"
                                          class="text-[10px] text-error">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- ================= ORDER SUMMARY ================= -->
                        <div class="px-4 py-5 sm:px-5">

                            <!-- Section Header -->
                            <div class="mb-4 flex items-center gap-3">

                                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 text-primary">
                                    <i class="bi bi-receipt"></i>
                                </div>

                                <div>
                                    <h2 class="text-sm font-bold text-base-content">
                                        Order Summary
                                    </h2>

                                    <p class="text-[10px] text-base-content/50">
                                        Review your order total
                                    </p>
                                </div>

                            </div>


                            <!-- Items -->
                            <div class="space-y-2">

                                @foreach (var item in Model.ShoppingCartList)
                                {
                                    <div class="flex items-center justify-between gap-3 text-xs">

                                        <span class="min-w-0 truncate text-base-content/60">
                                            @item.Product.Title × @item.Count
                                        </span>

                                        <span class="shrink-0 font-semibold text-base-content">
                                            @((item.Price * item.Count).ToString("c"))
                                        </span>

                                    </div>
                                }

                            </div>


                            <div class="my-3 h-px bg-base-300"></div>


                            <!-- Shipping -->
                            <div class="flex items-center justify-between text-xs">

                                <span class="text-base-content/60">
                                    Shipping
                                </span>

                                <span class="font-bold text-success">
                                    Free
                                </span>

                            </div>

                        </div>


                        <!-- ================= TOTAL ================= -->
                        <div class="flex items-center justify-between border-y border-base-300 bg-primary px-4 py-4 text-primary-content sm:px-5">

                            <span class="text-xs font-semibold uppercase tracking-wider">
                                Total
                            </span>

                            <span class="text-xl font-extrabold">
                                @Model.OrderHeader.OrderTotal.ToString("c")
                            </span>

                        </div>


                        <!-- ================= PLACE ORDER ================= -->
                        <div class="px-4 py-5 sm:px-5">

                            <button type="submit"
                                    class="btn btn-primary h-11 min-h-11 w-full gap-2 font-bold shadow-md shadow-primary/20 transition hover:-translate-y-0.5">

                                <i class="bi bi-lock-fill"></i>
                                Place Order

                            </button>


                            <!-- Trust Indicators -->
                            <div class="mt-4 grid grid-cols-3 gap-2 text-center text-[9px] font-medium text-base-content/45">

                                <span class="flex flex-col items-center gap-1">
                                    <i class="bi bi-shield-check text-sm text-primary"></i>
                                    Secure
                                </span>

                                <span class="flex flex-col items-center gap-1">
                                    <i class="bi bi-truck text-sm text-primary"></i>
                                    Free Shipping
                                </span>

                                <span class="flex flex-col items-center gap-1">
                                    <i class="bi bi-arrow-counterclockwise text-sm text-primary"></i>
                                    Easy Returns
                                </span>

                            </div>

                        </div>

                    </div>

                </aside>

            </div>

        </form>

    </div>
</div>


@section Scripts {

    <script>
        function updateCart(cartId, count) {
            fetch('/Customer/Cart/UpdateCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: 'cartId=' + encodeURIComponent(cartId) +
                    '&count=' + encodeURIComponent(count)
            })
                .then(response => {
                    if (response.ok) {
                        window.location.reload();
                    }
                });
        }
    </script>

    <partial name="_ValidationScriptsPartial" />

}