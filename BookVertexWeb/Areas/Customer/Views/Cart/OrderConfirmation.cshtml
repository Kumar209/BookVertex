@model int

<div class="min-h-[calc(100vh-68px)] bg-base-200 py-5 sm:px-6 sm:py-6 lg:px-8">

    <div class="mx-auto flex w-full items-center justify-center">

        <div class="w-[calc(100%-2rem)] max-w-md overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm">

            <!-- Success Header -->
            <div class="border-b border-base-300 px-5 py-5 text-center sm:px-6 sm:py-6">

                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-success/10 text-success">
                    <i class="bi bi-check-lg text-2xl"></i>
                </div>

                <h1 class="mt-3 text-xl font-extrabold tracking-tight text-base-content sm:text-2xl">
                    Order Confirmed!
                </h1>

                <p class="mx-auto mt-1.5 max-w-sm text-xs leading-relaxed text-base-content/55 sm:text-sm">
                    Thank you for your purchase. Your order has been successfully placed and we're preparing it for shipment.
                </p>

            </div>


            <!-- Order Details -->
            <div class="px-4 py-4 sm:px-6">

                <div class="overflow-hidden rounded-xl border border-base-300">

                    <!-- Order Number Header -->
                    <div class="flex items-center gap-3 border-b border-base-300 bg-base-200/50 px-3 py-2.5">

                        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                            <i class="bi bi-receipt text-sm"></i>
                        </div>

                        <div>
                            <p class="text-[9px] font-bold uppercase tracking-[0.15em] text-base-content/45">
                                Order Number
                            </p>

                            <p class="text-[10px] text-base-content/50">
                                Keep this number for your records
                            </p>
                        </div>

                    </div>


                    <!-- Order Number -->
                    <div class="px-4 py-4 text-center">

                        <span class="text-2xl font-extrabold tracking-tight text-primary sm:text-3xl">
                            @Model
                        </span>

                    </div>


                    <!-- Status Information -->
                    <div class="grid grid-cols-1 border-t border-base-300 sm:grid-cols-2">

                        <!-- Confirmation -->
                        <div class="flex w-full items-center gap-3 px-4 py-3">

                            <i class="bi bi-envelope-check text-sm text-primary"></i>

                            <div>
                                <p class="text-xs font-semibold text-base-content">
                                    Confirmation
                                </p>

                                <p class="text-[10px] text-base-content/50">
                                    Order received
                                </p>
                            </div>

                        </div>


                        <!-- Shipping -->
                        <div class="flex w-full items-center gap-3 border-t border-base-300 px-4 py-3 sm:border-l sm:border-t-0">

                            <i class="bi bi-truck text-sm text-primary"></i>

                            <div>
                                <p class="text-xs font-semibold text-base-content">
                                    Shipping
                                </p>

                                <p class="text-[10px] text-base-content/50">
                                    Tracking soon
                                </p>
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Actions -->
            <div class="border-t border-base-300 bg-base-200/30 px-4 py-4 sm:px-6">

                <div class="grid gap-2">

                    <a asp-area="Admin"
                       asp-controller="Order"
                       asp-action="Index"
                       class="btn btn-primary h-10 min-h-10 w-full gap-2 text-sm font-bold shadow-sm">

                        <i class="bi bi-box-seam"></i>
                        View My Orders

                    </a>


                    <a asp-area="Customer"
                       asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline h-10 min-h-10 w-full gap-2 text-sm font-semibold">

                        <i class="bi bi-house"></i>
                        Continue Shopping

                    </a>

                </div>


                <!-- Footer Message -->
                <div class="mt-3 flex items-center justify-center gap-1.5 text-[9px] text-base-content/40">

                    <i class="bi bi-shield-check"></i>

                    <span>
                        Thank you for choosing BookVertex
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>