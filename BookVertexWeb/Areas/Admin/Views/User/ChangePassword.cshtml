@model AdminChangePasswordVM

<div class="mx-auto w-full max-w-2xl px-4 py-6 sm:px-6 lg:px-8">

    <div class="mb-5">
        <a asp-action="Index"
           class="inline-flex items-center gap-1.5 text-sm font-semibold text-base-content/60 transition hover:text-primary">
            <i class="bi bi-arrow-left"></i>
            Back to Users
        </a>
    </div>

    <div class="overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm">

        <div class="border-b border-base-300 px-6 py-5">

            <div class="flex items-center gap-4">

                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-content">
                    <i class="bi bi-key-fill text-xl"></i>
                </div>

                <div>
                    <h1 class="text-xl font-bold text-base-content sm:text-2xl">
                        Change User Password
                    </h1>

                    <p class="mt-0.5 text-sm text-base-content/60">
                        Reset the password for this user account
                    </p>
                </div>

            </div>

        </div>

        <div class="p-6">

            <div class="mb-5 flex items-start gap-3 rounded-xl border border-info/20 bg-info/10 p-4">

                <i class="bi bi-info-circle-fill mt-0.5 text-info"></i>

                <div>
                    <p class="text-xs font-bold text-base-content">
                        Administrator Action
                    </p>

                    <p class="mt-0.5 text-[11px] leading-relaxed text-base-content/60">
                        You are changing another user's password. The user's current password is not required.
                    </p>
                </div>

            </div>

            <div class="mb-6 rounded-xl border border-base-300 bg-base-200/40 px-4 py-3">

                <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-base-content/45">
                    User Account
                </p>

                <div class="mt-1 flex items-center gap-2">

                    <i class="bi bi-envelope text-primary"></i>

                    <span class="truncate text-sm font-semibold text-base-content">
                        @Model.UserEmail
                    </span>

                </div>

            </div>

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="mb-4 text-xs text-error">
                </div>

                <input asp-for="UserId" type="hidden" />
                <input asp-for="UserEmail" type="hidden" />

                <div class="mb-4">

                    <label asp-for="NewPassword"
                           class="mb-1.5 block text-sm font-semibold text-base-content">
                        New Password
                    </label>

                    <div class="relative">

                        <input asp-for="NewPassword"
                               type="password"
                               class="input input-bordered w-full bg-base-100 pr-10 text-sm focus:border-primary focus:outline-none"
                               placeholder="Enter new password" />

                        <button type="button"
                                onclick="togglePassword('NewPassword', this)"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 transition hover:text-primary">
                            <i class="bi bi-eye"></i>
                        </button>

                    </div>

                    <span asp-validation-for="NewPassword"
                          class="mt-1 block text-[10px] text-error">
                    </span>

                    <p class="mt-1 text-[10px] text-base-content/45">
                        Minimum 6 characters.
                    </p>

                </div>

                <div class="mb-6">

                    <label asp-for="ConfirmPassword"
                           class="mb-1.5 block text-sm font-semibold text-base-content">
                        Confirm Password
                    </label>

                    <div class="relative">

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="input input-bordered w-full bg-base-100 pr-10 text-sm focus:border-primary focus:outline-none"
                               placeholder="Confirm new password" />

                        <button type="button"
                                onclick="togglePassword('ConfirmPassword', this)"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-base-content/40 transition hover:text-primary">
                            <i class="bi bi-eye"></i>
                        </button>

                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="mt-1 block text-[10px] text-error">
                    </span>

                </div>

                <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">

                    <a asp-action="Index"
                       class="btn btn-outline h-10 min-h-10 gap-2 font-semibold sm:w-auto">
                        <i class="bi bi-x-circle"></i>
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary h-10 min-h-10 gap-2 font-bold shadow-sm sm:w-auto">
                        <i class="bi bi-check-circle"></i>
                        Change Password
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            const icon = button.querySelector('i');

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
}