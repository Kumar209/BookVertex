@using BookVertex.Models.ViewModels
@model ProductVM

@{
    var isEdit = Model.Product.Id != 0;
}

<div class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:px-8">

    <a asp-action="Index"
       class="mb-4 inline-flex items-center gap-2 text-sm font-medium text-base-content/60 transition hover:text-primary">
        <i class="bi bi-arrow-left"></i>
        Back to products
    </a>

    <div class="overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm">

        <div class="flex items-center gap-4 border-b border-base-300 bg-base-200/40 px-6 py-5">

            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-content">
                <i class="bi @(isEdit ? "bi-pencil-square" : "bi-plus-lg") text-xl"></i>
            </div>

            <div>
                <h1 class="text-xl font-bold text-base-content sm:text-2xl">
                    @(isEdit ? "Edit Product" : "Create Product")
                </h1>

                <p class="mt-0.5 text-sm text-base-content/60">
                    @(isEdit
                        ? "Update your product information and pricing"
                        : "Add a new book to your product catalog")
                </p>
            </div>

        </div>


        <form method="post"
              enctype="multipart/form-data"
              class="p-6">

            <input asp-for="Product.Id" hidden />
            <input asp-for="Product.ImageUrl" hidden />

            <div asp-validation-summary="ModelOnly"
                 class="mb-5 rounded-lg border border-error/20 bg-error/5 px-4 py-3 text-sm text-error">
            </div>


            <div class="@(isEdit ? "grid grid-cols-1 gap-8 lg:grid-cols-3" : "block")">


                <div class="space-y-6 @(isEdit ? "lg:col-span-2" : "")">


                    <div>

                        <h2 class="text-sm font-bold uppercase tracking-wide text-base-content/70">
                            Basic Information
                        </h2>

                        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">


                            <div class="sm:col-span-2">

                                <label asp-for="Product.Title"
                                       class="mb-1.5 block text-sm font-semibold">
                                </label>

                                <input asp-for="Product.Title"
                                       type="text"
                                       placeholder="Enter product title"
                                       class="input input-bordered w-full focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/10" />

                                <span asp-validation-for="Product.Title"
                                      class="mt-1 block text-xs text-error">
                                </span>

                            </div>


                            <div>

                                <label asp-for="Product.ISBN"
                                       class="mb-1.5 block text-sm font-semibold">
                                </label>

                                <input asp-for="Product.ISBN"
                                       type="text"
                                       placeholder="Enter ISBN"
                                       class="input input-bordered w-full focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/10" />

                                <span asp-validation-for="Product.ISBN"
                                      class="mt-1 block text-xs text-error">
                                </span>

                            </div>


                            <div>

                                <label asp-for="Product.Author"
                                       class="mb-1.5 block text-sm font-semibold">
                                </label>

                                <input asp-for="Product.Author"
                                       type="text"
                                       placeholder="Enter author name"
                                       class="input input-bordered w-full focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/10" />

                                <span asp-validation-for="Product.Author"
                                      class="mt-1 block text-xs text-error">
                                </span>

                            </div>


                            <div class="sm:col-span-2">

                                <label asp-for="Product.CategoryId"
                                       class="mb-1.5 block text-sm font-semibold">
                                </label>

                                <select asp-for="Product.CategoryId"
                                        asp-items="@Model.CategoryList"
                                        class="select select-bordered w-full focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/10">

                                    <option value="">
                                        -- Select Category --
                                    </option>

                                </select>

                                <span asp-validation-for="Product.CategoryId"
                                      class="mt-1 block text-xs text-error">
                                </span>

                            </div>

                        </div>

                    </div>


                    <div>

                        <h2 class="text-sm font-bold uppercase tracking-wide text-base-content/70">
                            Description
                        </h2>

                        <div class="mt-4">

                            <textarea asp-for="Product.Description"
                                      class="hidden">
                            </textarea>

                            <div id="quill-editor"
                                 class="product-quill-editor">
                            </div>

                            <span asp-validation-for="Product.Description"
                                  class="mt-1 block text-xs text-error">
                            </span>

                        </div>

                    </div>


                    <div>

                        <div class="flex items-center justify-between">

                            <div>

                                <h2 class="text-sm font-bold uppercase tracking-wide text-base-content/70">
                                    Pricing
                                </h2>

                                <p class="mt-1 text-xs text-base-content/50">
                                    Configure prices based on purchase quantity.
                                </p>

                            </div>

                            <i class="bi bi-currency-dollar text-lg text-primary"></i>

                        </div>


                        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">


                            <div>

                                <label asp-for="Product.ListPrice"
                                       class="mb-1.5 block text-sm font-semibold">
                                </label>

                                <div class="relative">

                                    <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-base-content/50">
                                        $
                                    </span>

                                    <input asp-for="Product.ListPrice"
                                           type="number"
                                           min="1"
                                           max="1000"
                                           step="0.01"
                                           placeholder="0.00"
                                           class="input input-bordered w-full pl-5 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/10" />

                                </div>

                                <span asp-validation-for="Product.ListPrice"
                                      class="mt-1 block text-xs text-error">
                                </span>

                            </div>


                            <div>

                                <label asp-for="Product.Price"
                                       class="mb-1.5 block text-sm font-semibold">
                                </label>

                                <div class="relative">

                                    <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-base-content/50">
                                        $
                                    </span>

                                    <input asp-for="Product.Price"
                                           type="number"
                                           min="1"
                                           max="1000"
                                           step="0.01"
                                           placeholder="0.00"
                                           class="input input-bordered w-full pl-5 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/10" />

                                </div>

                                <span asp-validation-for="Product.Price"
                                      class="mt-1 block text-xs text-error">
                                </span>

                            </div>


                            <div>

                                <label asp-for="Product.Price50"
                                       class="mb-1.5 block text-sm font-semibold">
                                </label>

                                <div class="relative">

                                    <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-base-content/50">
                                        $
                                    </span>

                                    <input asp-for="Product.Price50"
                                           type="number"
                                           min="1"
                                           max="1000"
                                           step="0.01"
                                           placeholder="0.00"
                                           class="input input-bordered w-full pl-5 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/10" />

                                </div>

                                <span asp-validation-for="Product.Price50"
                                      class="mt-1 block text-xs text-error">
                                </span>

                            </div>


                            <div>

                                <label asp-for="Product.Price100"
                                       class="mb-1.5 block text-sm font-semibold">
                                </label>

                                <div class="relative">

                                    <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-base-content/50">
                                        $
                                    </span>

                                    <input asp-for="Product.Price100"
                                           type="number"
                                           min="1"
                                           max="1000"
                                           step="0.01"
                                           placeholder="0.00"
                                           class="input input-bordered w-full pl-5 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/10" />

                                </div>

                                <span asp-validation-for="Product.Price100"
                                      class="mt-1 block text-xs text-error">
                                </span>

                            </div>

                        </div>

                    </div>


                    <div>

                        <h2 class="text-sm font-bold uppercase tracking-wide text-base-content/70">
                            Product Image
                        </h2>

                        <div class="mt-4 rounded-xl border-2 border-dashed border-base-300 bg-base-200/20 p-5 transition hover:border-primary/40">

                            <div class="flex flex-col items-center justify-center text-center">

                                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
                                    <i class="bi bi-cloud-arrow-up text-xl"></i>
                                </div>

                                <p class="mt-3 text-sm font-semibold">
                                    Upload product image
                                </p>

                                <p class="mt-1 text-xs text-base-content/50">
                                    JPG or PNG recommended
                                </p>

                                <input type="file"
                                       id="productImage"
                                       name="file"
                                       accept="image/jpeg,image/png"
                                       class="file-input file-input-bordered mt-4 w-full max-w-md" />

                                <div id="selectedImageName"
                                     class="mt-3 hidden rounded-lg bg-success/10 px-3 py-2 text-xs text-success">
                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="flex flex-wrap items-center gap-3 border-t border-base-300 pt-5">

                        <button type="submit"
                                class="btn btn-primary gap-2 px-5">

                            <i class="bi @(isEdit ? "bi-check-lg" : "bi-plus-lg")"></i>

                            @(isEdit ? "Update Product" : "Create Product")

                        </button>

                        <a asp-controller="Product"
                           asp-action="Index"
                           class="btn btn-ghost gap-2">

                            <i class="bi bi-x-lg"></i>
                            Cancel

                        </a>

                    </div>

                </div>


                @if (isEdit)
                {
                    <div class="lg:col-span-1">

                        <div class="sticky top-24 rounded-xl border border-base-300 bg-base-200/30 p-4">

                            <div class="mb-4 flex items-center justify-between">

                                <div>

                                    <h2 class="text-sm font-bold">
                                        Product Preview
                                    </h2>

                                    <p class="text-xs text-base-content/50">
                                        Current product image
                                    </p>

                                </div>

                                <i class="bi bi-image text-lg text-base-content/40"></i>

                            </div>


                            @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                            {
                                <div class="overflow-hidden rounded-xl border border-base-300 bg-base-100">

                                    <img src="@Model.Product.ImageUrl"
                                         alt="@Model.Product.Title"
                                         class="product-preview-image w-full object-cover" />

                                </div>

                                <div class="mt-3 flex items-start gap-2 rounded-lg bg-info/10 px-3 py-2.5 text-xs text-info">

                                    <i class="bi bi-info-circle mt-0.5"></i>

                                    <span>
                                        Upload a new image above to replace the current image.
                                    </span>

                                </div>
                            }
                            else
                            {
                                <div class="flex aspect-[4/3] flex-col items-center justify-center rounded-xl border border-base-300 bg-base-100 text-base-content/40">

                                    <i class="bi bi-image text-5xl"></i>

                                    <p class="mt-3 text-sm font-medium">
                                        No image uploaded
                                    </p>

                                    <p class="mt-1 text-xs">
                                        Upload an image above
                                    </p>

                                </div>
                            }


                            <div class="mt-5 space-y-3 border-t border-base-300 pt-4">

                                <div class="flex items-center justify-between gap-4 text-sm">

                                    <span class="text-base-content/50">
                                        Product
                                    </span>

                                    <span class="max-w-[180px] truncate font-medium">
                                        @(string.IsNullOrWhiteSpace(Model.Product.Title)
                                            ? "New Product"
                                            : Model.Product.Title)
                                    </span>

                                </div>


                                <div class="flex items-center justify-between gap-4 text-sm">

                                    <span class="text-base-content/50">
                                        ISBN
                                    </span>

                                    <span class="font-medium">
                                        @(string.IsNullOrWhiteSpace(Model.Product.ISBN)
                                            ? "—"
                                            : Model.Product.ISBN)
                                    </span>

                                </div>


                                <div class="flex items-center justify-between gap-4 text-sm">

                                    <span class="text-base-content/50">
                                        Author
                                    </span>

                                    <span class="max-w-[180px] truncate font-medium">
                                        @(string.IsNullOrWhiteSpace(Model.Product.Author)
                                            ? "—"
                                            : Model.Product.Author)
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" />

    <link rel="stylesheet"
          href="~/css/products.css"
          asp-append-version="true" />

    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const editorElement = document.getElementById("quill-editor");
            const textAreaDesc = document.querySelector('textarea[name="Product.Description"]');

            if (editorElement && textAreaDesc) {

                const quill = new Quill("#quill-editor", {
                    theme: "snow",
                    placeholder: "Write a detailed description...",
                    modules: {
                        toolbar: [
                            [{ header: [1, 2, 3, false] }],
                            ["bold", "italic", "underline"],
                            ["link"],
                            [{ list: "ordered" }, { list: "bullet" }],
                            ["clean"]
                        ]
                    }
                });

                if (textAreaDesc.value && textAreaDesc.value.trim() !== "") {
                    quill.root.innerHTML = textAreaDesc.value;
                }

                quill.on("text-change", function () {
                    textAreaDesc.value = quill.root.innerHTML;
                });
            }


            const imageInput = document.getElementById("productImage");
            const imageName = document.getElementById("selectedImageName");

            if (imageInput && imageName) {

                imageInput.addEventListener("change", function () {

                    if (!this.files || this.files.length === 0) {
                        imageName.classList.add("hidden");
                        imageName.textContent = "";
                        return;
                    }

                    const file = this.files[0];

                    imageName.textContent = "Selected image: " + file.name;
                    imageName.classList.remove("hidden");
                });

            }

        });

    </script>
}