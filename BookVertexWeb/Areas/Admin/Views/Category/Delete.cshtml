@using BookVertex.Models
@model Category

<div class="mx-auto flex w-full max-w-5xl flex-1 flex-col px-4 py-6 sm:px-6 lg:py-10">

    <a asp-action="Index"
       class="mb-5 inline-flex w-fit items-center gap-1.5 text-sm font-medium text-base-content/60 transition-colors hover:text-primary">
        <i class="bi bi-arrow-left"></i>
        Back to categories
    </a>

    <div class="mx-auto w-full max-w-4xl overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm">

        <div class="border-b border-base-300 p-5 sm:p-6">

            <div class="flex items-center gap-3">

                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-error text-error-content shadow-sm">
                    <i class="bi bi-trash3 text-lg"></i>
                </div>

                <div>
                    <h1 class="text-lg font-bold tracking-tight sm:text-xl">
                        Delete Category
                    </h1>

                    <p class="mt-0.5 text-xs text-base-content/60 sm:text-sm">
                        Permanently remove this category from your books
                    </p>
                </div>

            </div>

        </div>

        <div class="p-5 sm:p-7">

            <div class="mb-6 flex items-start gap-3 rounded-xl border border-error/20 bg-error/5 p-4">

                <i class="bi bi-exclamation-triangle-fill mt-0.5 shrink-0 text-error"></i>

                <div>
                    <p class="text-sm font-semibold text-error">
                        Are you sure you want to delete this category?
                    </p>

                    <p class="mt-1 text-xs text-base-content/60 sm:text-sm">
                        This action cannot be undone. Please review the category details before continuing.
                    </p>
                </div>

            </div>

            <form method="post" asp-action="Delete" class="space-y-6">

                <input asp-for="Id" type="hidden" />

                <div class="grid gap-5 sm:grid-cols-2">

                    <div>
                        <label asp-for="Name"
                               class="mb-2 block text-sm font-semibold">
                            Category Name
                        </label>

                        <input type="text"
                               asp-for="Name"
                               readonly
                               class="input w-full cursor-not-allowed border-base-300 bg-base-200/60 text-base-content/70 shadow-none outline-none" />
                    </div>

                    <div>
                        <label asp-for="DisplayOrder"
                               class="mb-2 block text-sm font-semibold">
                            Display Order
                        </label>

                        <input type="number"
                               asp-for="DisplayOrder"
                               readonly
                               class="input w-full cursor-not-allowed border-base-300 bg-base-200/60 text-base-content/70 shadow-none outline-none" />
                    </div>

                </div>

                <div class="border-t border-base-300 pt-5">

                    <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">

                        <a asp-controller="Category"
                           asp-action="Index"
                           class="btn border-base-300 bg-base-100 px-5 font-medium shadow-none hover:border-base-content/20 hover:bg-base-200">

                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-error gap-2 px-5 font-semibold shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:shadow-md">

                            <i class="bi bi-trash3"></i>

                            Delete Category

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @* Validation scripts are kept available for future validation requirements. *@
    <partial name="_ValidationScriptsPartial" />
}