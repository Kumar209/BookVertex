@using BookVertex.Utility
@model OrderHeader

@{
    var isCustomer = User.IsInRole(SD.RoleCustomer);
    var canManageOrder = User.IsInRole(SD.RoleAdmin) || User.IsInRole(SD.RoleEmployee);
}

<div class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-5">
        <a asp-action="Index"
           class="inline-flex items-center gap-1.5 text-sm font-semibold text-base-content/60 transition hover:text-primary">
            <i class="bi bi-arrow-left"></i>
            Back to orders
        </a>
    </div>

    <form method="post">
        <input asp-for="Id" hidden />

        <div class="overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm">

            <!-- Header -->
            <div class="border-b border-base-300 px-6 py-5">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <div class="flex items-center gap-4">
                        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-content shadow-sm">
                            <i class="bi bi-receipt text-2xl"></i>
                        </div>
                        <div>
                            <div class="flex flex-wrap items-center gap-2">
                                <h1 class="text-2xl font-bold text-base-content">
                                    Order #@Model.Id
                                </h1>
                                <span class="order-detail-status">
                                    <i class="bi bi-circle-fill text-[7px]"></i>
                                    @Model.OrderStatus
                                </span>
                            </div>
                            <p class="mt-1 text-sm text-base-content/60">
                                Placed on @Model.OrderDate.ToShortDateString()
                            </p>
                        </div>
                    </div>

                    <div class="text-left sm:text-right">
                        <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-base-content/45">
                            Order Total
                        </p>
                        <p class="mt-0.5 text-2xl font-extrabold text-primary">
                            @Model.OrderTotal.ToString("c")
                        </p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)]">

                <!-- Order Details -->
                <div class="border-b border-base-300 p-6 lg:border-b-0 lg:border-r">
                    <div class="mb-5 flex items-center gap-3">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                            <i class="bi bi-person-lines-fill text-lg"></i>
                        </div>
                        <div>
                            <h2 class="text-sm font-bold text-base-content">
                                Order Details
                            </h2>
                            <p class="text-[11px] text-base-content/50">
                                Customer and delivery information
                            </p>
                        </div>
                    </div>

                    <div class="space-y-4">

                        <div>
                            <label asp-for="Name"
                                   class="mb-1.5 block text-[11px] font-semibold text-base-content/70">
                            </label>
                            @if (isCustomer)
                            {
                                <input asp-for="Name"
                                       disabled
                                       class="input input-bordered input-sm w-full bg-base-100 text-sm" />
                            }
                            else
                            {
                                <input asp-for="Name"
                                       class="input input-bordered input-sm w-full bg-base-100 text-sm focus:border-primary focus:outline-none" />
                                <span asp-validation-for="Name"
                                      class="mt-1 block text-[10px] text-error">
                                </span>
                            }
                        </div>

                        <div>
                            <label asp-for="PhoneNumber"
                                   class="mb-1.5 block text-[11px] font-semibold text-base-content/70">
                            </label>
                            @if (isCustomer)
                            {
                                <input asp-for="PhoneNumber"
                                       disabled
                                       class="input input-bordered input-sm w-full bg-base-100 text-sm" />
                            }
                            else
                            {
                                <input asp-for="PhoneNumber"
                                       class="input input-bordered input-sm w-full bg-base-100 text-sm focus:border-primary focus:outline-none" />
                                <span asp-validation-for="PhoneNumber"
                                      class="mt-1 block text-[10px] text-error">
                                </span>
                            }
                        </div>

                        <div>
                            <label asp-for="ApplicationUser.Email"
                                   class="mb-1.5 block text-[11px] font-semibold text-base-content/70">
                                Email
                            </label>
                            <input asp-for="ApplicationUser.Email"
                                   disabled
                                   class="input input-bordered input-sm w-full bg-base-100 text-sm" />
                        </div>

                        <div class="border-t border-base-300 pt-5">
                            <div class="mb-4 flex items-center gap-2">
                                <i class="bi bi-geo-alt text-primary"></i>
                                <h3 class="text-xs font-bold text-base-content">
                                    Shipping Address
                                </h3>
                            </div>

                            <div class="mb-4">
                                <label asp-for="StreetAddress"
                                       class="mb-1.5 block text-[11px] font-semibold text-base-content/70">
                                </label>
                                @if (isCustomer)
                                {
                                    <input asp-for="StreetAddress"
                                           disabled
                                           class="input input-bordered input-sm w-full bg-base-100 text-sm" />
                                }
                                else
                                {
                                    <input asp-for="StreetAddress"
                                           class="input input-bordered input-sm w-full bg-base-100 text-sm focus:border-primary focus:outline-none" />
                                    <span asp-validation-for="StreetAddress"
                                          class="mt-1 block text-[10px] text-error">
                                    </span>
                                }
                            </div>

                            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                                <div>
                                    <label asp-for="City"
                                           class="mb-1.5 block text-[11px] font-semibold text-base-content/70">
                                    </label>
                                    @if (isCustomer)
                                    {
                                        <input asp-for="City"
                                               disabled
                                               class="input input-bordered input-sm w-full bg-base-100 text-sm" />
                                    }
                                    else
                                    {
                                        <input asp-for="City"
                                               class="input input-bordered input-sm w-full bg-base-100 text-sm focus:border-primary focus:outline-none" />
                                        <span asp-validation-for="City"
                                              class="mt-1 block text-[10px] text-error">
                                        </span>
                                    }
                                </div>

                                <div>
                                    <label asp-for="State"
                                           class="mb-1.5 block text-[11px] font-semibold text-base-content/70">
                                    </label>
                                    @if (isCustomer)
                                    {
                                        <input asp-for="State"
                                               disabled
                                               class="input input-bordered input-sm w-full bg-base-100 text-sm" />
                                    }
                                    else
                                    {
                                        <input asp-for="State"
                                               class="input input-bordered input-sm w-full bg-base-100 text-sm uppercase focus:border-primary focus:outline-none" />
                                        <span asp-validation-for="State"
                                              class="mt-1 block text-[10px] text-error">
                                        </span>
                                    }
                                </div>

                                <div>
                                    <label asp-for="PostalCode"
                                           class="mb-1.5 block text-[11px] font-semibold text-base-content/70">
                                    </label>
                                    @if (isCustomer)
                                    {
                                        <input asp-for="PostalCode"
                                               disabled
                                               class="input input-bordered input-sm w-full bg-base-100 text-sm" />
                                    }
                                    else
                                    {
                                        <input asp-for="PostalCode"
                                               class="input input-bordered input-sm w-full bg-base-100 text-sm focus:border-primary focus:outline-none" />
                                        <span asp-validation-for="PostalCode"
                                              class="mt-1 block text-[10px] text-error">
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="border-t border-base-300 pt-5">
                            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                                <div>
                                    <p class="mb-1.5 text-[11px] font-semibold text-base-content/70">
                                        Order Date
                                    </p>
                                    <div class="flex h-8 items-center gap-2 text-sm text-base-content/70">
                                        <i class="bi bi-calendar3 text-primary"></i>
                                        @Model.OrderDate.ToShortDateString()
                                    </div>
                                </div>

                                @if (Model.ShippingDate != default(DateTime))
                                {
                                    <div>
                                        <p class="mb-1.5 text-[11px] font-semibold text-base-content/70">
                                            Shipping Date
                                        </p>
                                        <div class="flex h-8 items-center gap-2 text-sm text-base-content/70">
                                            <i class="bi bi-truck text-primary"></i>
                                            @Model.ShippingDate.ToShortDateString()
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (Model.OrderStatus != SD.StatusPending &&
                             Model.OrderStatus != SD.StatusApproved)
                        {
                            <div class="border-t border-base-300 pt-5">
                                <div class="mb-4 flex items-center gap-2">
                                    <i class="bi bi-truck text-primary"></i>
                                    <h3 class="text-xs font-bold text-base-content">
                                        Shipping Information
                                    </h3>
                                </div>

                                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                                    <div>
                                        <label asp-for="Carrier"
                                               class="mb-1.5 block text-[11px] font-semibold text-base-content/70">
                                        </label>
                                        @if (isCustomer)
                                        {
                                            <input asp-for="Carrier"
                                                   disabled
                                                   class="input input-bordered input-sm w-full bg-base-100 text-sm" />
                                        }
                                        else
                                        {
                                            <input asp-for="Carrier"
                                                   id="carrier"
                                                   class="input input-bordered input-sm w-full bg-base-100 text-sm focus:border-primary focus:outline-none" />
                                        }
                                    </div>

                                    <div>
                                        <label asp-for="TrackingNumber"
                                               class="mb-1.5 block text-[11px] font-semibold text-base-content/70">
                                        </label>
                                        @if (isCustomer)
                                        {
                                            <input asp-for="TrackingNumber"
                                                   disabled
                                                   class="input input-bordered input-sm w-full bg-base-100 text-sm" />
                                        }
                                        else
                                        {
                                            <input asp-for="TrackingNumber"
                                                   type="text"
                                                   id="trackingNumber"
                                                   class="input input-bordered input-sm w-full bg-base-100 text-sm focus:border-primary focus:outline-none" />
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        @if (canManageOrder)
                        {
                            <button asp-action="UpdateOrderDetails"
                                    type="submit"
                                    class="btn btn-primary h-10 min-h-10 w-full gap-2 font-bold shadow-sm">
                                <i class="bi bi-check2-circle"></i>
                                Update Order Details
                            </button>
                        }
                    </div>
                </div>

                <!-- Order Summary -->
                <div class="p-6">
                    <div class="mb-5 flex items-center gap-3">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                            <i class="bi bi-receipt text-lg"></i>
                        </div>
                        <div>
                            <h2 class="text-sm font-bold text-base-content">
                                Order Summary
                            </h2>
                            <p class="text-[11px] text-base-content/50">
                                Items included in this order
                            </p>
                        </div>
                    </div>

                    <div class="mb-4 flex items-center justify-between rounded-xl border border-base-300 bg-base-200/40 px-4 py-3">
                        <div class="flex items-center gap-2">
                            <i class="bi bi-info-circle text-primary"></i>
                            <span class="text-xs font-semibold text-base-content">
                                Current Status
                            </span>
                        </div>
                        <span class="order-detail-status">
                            <i class="bi bi-circle-fill text-[7px]"></i>
                            @Model.OrderStatus
                        </span>
                    </div>

                    <div class="overflow-hidden rounded-xl border border-base-300">
                        <div class="border-b border-base-300 bg-base-200/40 px-4 py-3">
                            <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-base-content/50">
                                Order Items
                            </p>
                        </div>

                        @foreach (var details in Model.OrderDetails)
                        {
                            <div class="flex items-center justify-between gap-4 border-b border-base-300 px-4 py-4 last:border-b-0">
                                <div class="min-w-0">
                                    <p class="truncate text-sm font-semibold text-base-content">
                                        @details.Product.Title
                                    </p>
                                    <p class="mt-1 text-[11px] text-base-content/50">
                                        @details.Price.ToString("c") × @details.Count
                                    </p>
                                </div>
                                <p class="shrink-0 text-sm font-bold text-primary">
                                    @((details.Price * details.Count).ToString("c"))
                                </p>
                            </div>
                        }

                        <div class="flex items-center justify-between bg-primary px-4 py-4 text-primary-content">
                            <span class="text-xs font-bold uppercase tracking-wider">
                                Total
                            </span>
                            <span class="text-xl font-extrabold">
                                @Model.OrderTotal.ToString("c")
                            </span>
                        </div>
                    </div>

                    @if (canManageOrder)
                    {
                        <div class="mt-5 border-t border-base-300 pt-5">
                            <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.15em] text-base-content/45">
                                Order Actions
                            </p>

                            <div class="grid gap-2">
                                @if (Model.OrderStatus == SD.StatusApproved)
                                {
                                    <button type="submit"
                                            asp-action="UpdateOrderStatus"
                                            asp-route-status="@SD.StatusInProcess"
                                            class="btn btn-primary h-10 min-h-10 w-full gap-2 font-semibold">
                                        <i class="bi bi-arrow-right-circle"></i>
                                        Start Processing
                                    </button>
                                }

                                @if (Model.OrderStatus == SD.StatusInProcess)
                                {
                                    <button asp-action="UpdateOrderStatus"
                                            asp-route-status="@SD.StatusShipped"
                                            type="submit"
                                            onclick="return validateInput()"
                                            class="btn btn-warning h-10 min-h-10 w-full gap-2 font-semibold">
                                        <i class="bi bi-truck"></i>
                                        Ship Order
                                    </button>
                                }

                                @if (Model.OrderStatus == SD.StatusApproved ||
                                     Model.OrderStatus == SD.StatusInProcess)
                                {
                                    <button asp-action="UpdateOrderStatus"
                                            asp-route-status="@SD.StatusCancelled"
                                            type="submit"
                                            class="btn btn-error h-10 min-h-10 w-full gap-2 font-semibold">
                                        <i class="bi bi-x-circle"></i>
                                        Cancel Order
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}