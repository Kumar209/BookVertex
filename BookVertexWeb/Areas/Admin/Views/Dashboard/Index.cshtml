@model DashboardVM

<div class="mx-auto w-full max-w-7xl px-4 py-5 sm:px-6 lg:px-8">

    <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-extrabold tracking-tight text-base-content sm:text-3xl">
                Welcome back! 👋
            </h1>
            <p class="mt-1 text-sm text-base-content/55">
                Here's what's happening with your store.
            </p>
        </div>

        <span class="flex w-fit items-center gap-2 rounded-full border border-base-300 bg-base-100 px-3 py-1.5 text-xs font-semibold text-base-content/60 shadow-sm">
            <span class="h-2 w-2 rounded-full bg-success"></span>
            Store overview
        </span>
    </div>

    @* <div class="mb-5 grid grid-cols-2 gap-3 xl:grid-cols-4"> *@
    <div class="mb-5 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">

        <div class="group rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
            <div class="flex items-start justify-between">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 text-primary">
                    <i class="bi bi-currency-rupee text-lg"></i>
                </div>

                <span class="text-[9px] font-bold uppercase tracking-[0.14em] text-base-content/40">
                    Revenue
                </span>
            </div>

            <div class="mt-3">
                <p class="text-xl font-extrabold tracking-tight text-base-content">
                    ₹@Model.TotalRevenue.ToString("N2")
                </p>

                <p class="mt-0.5 text-[11px] text-base-content/50">
                    Approved & shipped
                </p>
            </div>
        </div>

        <a asp-controller="Order"
           asp-action="Index"
           class="group rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-md">

            <div class="flex items-start justify-between">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-secondary/10 text-secondary">
                    <i class="bi bi-box-seam text-lg"></i>
                </div>

                <i class="bi bi-arrow-up-right text-xs text-base-content/30 transition group-hover:text-primary"></i>
            </div>

            <div class="mt-3">
                <p class="text-xl font-extrabold tracking-tight text-base-content">
                    @Model.TotalOrders
                </p>

                <p class="mt-0.5 text-[11px] text-base-content/50">
                    Total orders
                </p>
            </div>

            <div class="mt-2 text-[11px] font-bold text-primary">
                View orders
                <i class="bi bi-arrow-right ml-1"></i>
            </div>
        </a>

        <a asp-controller="Product"
           asp-action="Index"
           class="group rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-md">

            <div class="flex items-start justify-between">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent">
                    <i class="bi bi-book text-lg"></i>
                </div>

                <i class="bi bi-arrow-up-right text-xs text-base-content/30 transition group-hover:text-primary"></i>
            </div>

            <div class="mt-3">
                <p class="text-xl font-extrabold tracking-tight text-base-content">
                    @Model.TotalProducts
                </p>

                <p class="mt-0.5 text-[11px] text-base-content/50">
                    Books in catalog
                </p>
            </div>

            <div class="mt-2 text-[11px] font-bold text-primary">
                Manage products
                <i class="bi bi-arrow-right ml-1"></i>
            </div>
        </a>

        <a asp-controller="User"
           asp-action="Index"
           class="group rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-md">

            <div class="flex items-start justify-between">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-warning/10 text-warning">
                    <i class="bi bi-people text-lg"></i>
                </div>

                <i class="bi bi-arrow-up-right text-xs text-base-content/30 transition group-hover:text-primary"></i>
            </div>

            <div class="mt-3">
                <p class="text-xl font-extrabold tracking-tight text-base-content">
                    @Model.TotalUsers
                </p>

                <p class="mt-0.5 text-[11px] text-base-content/50">
                    Registered users
                </p>
            </div>

            <div class="mt-2 text-[11px] font-bold text-primary">
                Manage users
                <i class="bi bi-arrow-right ml-1"></i>
            </div>
        </a>

    </div>

    <div class="mb-5 grid grid-cols-1 gap-4 xl:grid-cols-2">

        <div class="overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm">
            <div class="flex items-center justify-between border-b border-base-300 px-5 py-4">
                <div class="flex items-center gap-3">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 text-primary">
                        <i class="bi bi-graph-up"></i>
                    </div>

                    <div>
                        <h2 class="text-sm font-bold text-base-content">
                            Revenue Trend
                        </h2>

                        <p class="text-[11px] text-base-content/45">
                            Revenue generated over the last 6 months
                        </p>
                    </div>
                </div>

                <span class="badge badge-primary badge-sm">
                    6 Months
                </span>
            </div>

            <div class="p-5">
                <div class="h-[280px] w-full">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>

        <div class="overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm">
            <div class="flex items-center justify-between border-b border-base-300 px-5 py-4">
                <div class="flex items-center gap-3">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-secondary/10 text-secondary">
                        <i class="bi bi-bar-chart-fill"></i>
                    </div>

                    <div>
                        <h2 class="text-sm font-bold text-base-content">
                            Orders Per Month
                        </h2>

                        <p class="text-[11px] text-base-content/45">
                            Monthly order activity
                        </p>
                    </div>
                </div>

                <span class="badge badge-secondary badge-sm">
                    6 Months
                </span>
            </div>

            <div class="p-5">
                <div class="h-[280px] w-full">
                    <canvas id="ordersChart"></canvas>
                </div>
            </div>
        </div>

    </div>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">

        <div class="overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm">
            <div class="flex items-center gap-3 border-b border-base-300 px-5 py-4">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-warning/10 text-warning">
                    <i class="bi bi-pie-chart-fill"></i>
                </div>

                <div>
                    <h2 class="text-sm font-bold text-base-content">
                        Order Status
                    </h2>

                    <p class="text-[11px] text-base-content/45">
                        Current distribution of orders
                    </p>
                </div>
            </div>

            <div class="flex min-h-[300px] items-center justify-center p-5">
                <div class="h-[270px] w-full max-w-[500px]">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>

        <div class="overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm">
            <div class="flex items-center gap-3 border-b border-base-300 px-5 py-4">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent">
                    <i class="bi bi-tags-fill"></i>
                </div>

                <div>
                    <h2 class="text-sm font-bold text-base-content">
                        Products by Category
                    </h2>

                    <p class="text-[11px] text-base-content/45">
                        Product catalog distribution
                    </p>
                </div>
            </div>

            <div class="p-5">
                <div class="h-[300px] w-full">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}