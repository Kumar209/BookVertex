@using BookVertex.Utility
<!DOCTYPE html>
<html lang="en" data-theme="bookvertex">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BookVertex</title>
    <link rel="icon"
          type="image/png"
          href="~/images/book.png"
          asp-append-version="true" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/app.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookVertexWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="//cdn.datatables.net/2.3.7/css/dataTables.dataTables.min.css" asp-append-version="true" />

    <script>
            (function() {
                const theme = localStorage.getItem("bookvertex-theme");
                if (theme) {
                    document.documentElement.setAttribute("data-theme", theme);
                }
            })();
    </script>
</head>

<body class="min-h-screen bg-base-200 text-base-content">
    <div class="drawer lg:drawer-open">
        <input id="admin-drawer" type="checkbox" class="drawer-toggle" />

        <div class="drawer-content flex min-h-screen flex-col p-0">
            <!-- Mobile Header -->
            <header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/95 backdrop-blur-md lg:hidden">
                <div class="flex h-16 items-center justify-between px-4">
                    <div class="flex items-center gap-3">
                        <label for="admin-drawer" class="btn btn-ghost btn-square btn-sm">
                            <i class="bi bi-list text-xl"></i>
                        </label>

                        <a asp-area="Customer" asp-controller="Home" asp-action="Index"
                           class="flex items-center gap-2 font-bold text-base-content">
                            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-content shadow-sm">
                                <i class="bi bi-book"></i>
                            </span>
                            <span>Book<span class="text-primary">Vertex</span></span>
                        </a>
                    </div>

                    <details class="dropdown dropdown-end">
                        <summary class="bv-theme-trigger" aria-label="Choose theme" title="Choose theme">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="bv-theme-icon">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M9.813 15.904L9 18l-.813-2.096A4.5 4.5 0 006.096 13.5L4 12l2.096-.813A4.5 4.5 0 008.187 9L9 6.904 9.813 9a4.5 4.5 0 002.091 2.187L14 12l-2.096 1.5a4.5 4.5 0 00-2.091 2.404zM18.259 8.715L18 10l-.259-1.285A2.25 2.25 0 0016.285 7.26L15 7l1.285-.259A2.25 2.25 0 0017.741 5.285L18 4l.259 1.285A2.25 2.25 0 0019.715 6.74L21 7l-1.285.259A2.25 2.25 0 0018.259 8.715zM18 16l-.387.968A3.75 3.75 0 0115.968 18.613L15 19l.968.387A3.75 3.75 0 0117.613 21L18 22l.387-.968A3.75 3.75 0 0119.032 19.387L20 19l-.968-.387A3.75 3.75 0 0018.387 17.968L18 16z" />
                            </svg>
                        </summary>

                        <div class="dropdown-content bv-theme-menu">
                            <div class="bv-theme-header">
                                <span>Choose Theme</span>
                            </div>
                            <div class="bv-theme-scroll">
                                <div class="bv-theme-grid">
                                    <button type="button" class="bv-theme-option" data-theme="light">light</button>
                                    <button type="button" class="bv-theme-option" data-theme="dark">dark</button>
                                    <button type="button" class="bv-theme-option" data-theme="cupcake">cupcake</button>
                                    <button type="button" class="bv-theme-option" data-theme="bumblebee">bumblebee</button>
                                    <button type="button" class="bv-theme-option" data-theme="emerald">emerald</button>
                                    <button type="button" class="bv-theme-option" data-theme="corporate">corporate</button>
                                    <button type="button" class="bv-theme-option" data-theme="synthwave">synthwave</button>
                                    <button type="button" class="bv-theme-option" data-theme="retro">retro</button>
                                    <button type="button" class="bv-theme-option" data-theme="cyberpunk">cyberpunk</button>
                                    <button type="button" class="bv-theme-option" data-theme="valentine">valentine</button>
                                    <button type="button" class="bv-theme-option" data-theme="halloween">halloween</button>
                                    <button type="button" class="bv-theme-option" data-theme="garden">garden</button>
                                    <button type="button" class="bv-theme-option" data-theme="forest">forest</button>
                                    <button type="button" class="bv-theme-option" data-theme="aqua">aqua</button>
                                    <button type="button" class="bv-theme-option" data-theme="lofi">lofi</button>
                                    <button type="button" class="bv-theme-option" data-theme="pastel">pastel</button>
                                    <button type="button" class="bv-theme-option" data-theme="fantasy">fantasy</button>
                                    <button type="button" class="bv-theme-option" data-theme="wireframe">wireframe</button>
                                    <button type="button" class="bv-theme-option" data-theme="black">black</button>
                                    <button type="button" class="bv-theme-option" data-theme="luxury">luxury</button>
                                    <button type="button" class="bv-theme-option" data-theme="dracula">dracula</button>
                                    <button type="button" class="bv-theme-option" data-theme="cmyk">cmyk</button>
                                    <button type="button" class="bv-theme-option" data-theme="autumn">autumn</button>
                                    <button type="button" class="bv-theme-option" data-theme="business">business</button>
                                    <button type="button" class="bv-theme-option" data-theme="acid">acid</button>
                                    <button type="button" class="bv-theme-option" data-theme="lemonade">lemonade</button>
                                    <button type="button" class="bv-theme-option" data-theme="night">night</button>
                                    <button type="button" class="bv-theme-option" data-theme="coffee">coffee</button>
                                    <button type="button" class="bv-theme-option" data-theme="winter">winter</button>
                                    <button type="button" class="bv-theme-option" data-theme="dim">dim</button>
                                    <button type="button" class="bv-theme-option" data-theme="nord">nord</button>
                                    <button type="button" class="bv-theme-option" data-theme="sunset">sunset</button>
                                    <button type="button" class="bv-theme-option" data-theme="caramellatte">caramellatte</button>
                                    <button type="button" class="bv-theme-option" data-theme="abyss">abyss</button>
                                    <button type="button" class="bv-theme-option" data-theme="silk">silk</button>
                                    <button type="button" class="bv-theme-option" data-theme="bookvertex">BookVertex</button>
                                </div>
                            </div>
                        </div>
                    </details>
                </div>
            </header>

            <!-- Desktop Top Bar -->
            <header class="sticky top-0 z-30 hidden h-16 border-b border-base-300 bg-base-100/90 backdrop-blur-md lg:block">
                <div class="flex h-full items-center justify-between px-6">
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary">
                            Administration
                        </p>
                        <h1 class="text-lg font-bold leading-tight text-base-content">
                            @ViewData["Title"]
                        </h1>
                    </div>

                    <div class="flex items-center gap-3">
                        <a asp-area="Customer" asp-controller="Home" asp-action="Index"
                           class="btn btn-ghost btn-sm gap-2">
                            <i class="bi bi-shop"></i>
                            Visit Store
                        </a>

                        <details class="dropdown dropdown-end">
                            <summary class="bv-theme-trigger" aria-label="Choose theme" title="Choose theme">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke-width="1.8"
                                     stroke="currentColor"
                                     class="bv-theme-icon">
                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          d="M9.813 15.904L9 18l-.813-2.096A4.5 4.5 0 006.096 13.5L4 12l2.096-.813A4.5 4.5 0 008.187 9L9 6.904 9.813 9a4.5 4.5 0 002.091 2.187L14 12l-2.096 1.5a4.5 4.5 0 00-2.091 2.404zM18.259 8.715L18 10l-.259-1.285A2.25 2.25 0 0016.285 7.26L15 7l1.285-.259A2.25 2.25 0 0017.741 5.285L18 4l.259 1.285A2.25 2.25 0 0019.715 6.74L21 7l-1.285.259A2.25 2.25 0 0018.259 8.715zM18 16l-.387.968A3.75 3.75 0 0115.968 18.613L15 19l.968.387A3.75 3.75 0 0117.613 21L18 22l.387-.968A3.75 3.75 0 0119.032 19.387L20 19l-.968-.387A3.75 3.75 0 0018.387 17.968L18 16z" />
                                </svg>
                            </summary>

                            <div class="dropdown-content bv-theme-menu">
                                <div class="bv-theme-header">
                                    <span>Choose Theme</span>
                                </div>
                                <div class="bv-theme-scroll">
                                    <div class="bv-theme-grid">
                                        <button type="button" class="bv-theme-option" data-theme="light">light</button>
                                        <button type="button" class="bv-theme-option" data-theme="dark">dark</button>
                                        <button type="button" class="bv-theme-option" data-theme="cupcake">cupcake</button>
                                        <button type="button" class="bv-theme-option" data-theme="bumblebee">bumblebee</button>
                                        <button type="button" class="bv-theme-option" data-theme="emerald">emerald</button>
                                        <button type="button" class="bv-theme-option" data-theme="corporate">corporate</button>
                                        <button type="button" class="bv-theme-option" data-theme="synthwave">synthwave</button>
                                        <button type="button" class="bv-theme-option" data-theme="retro">retro</button>
                                        <button type="button" class="bv-theme-option" data-theme="cyberpunk">cyberpunk</button>
                                        <button type="button" class="bv-theme-option" data-theme="valentine">valentine</button>
                                        <button type="button" class="bv-theme-option" data-theme="halloween">halloween</button>
                                        <button type="button" class="bv-theme-option" data-theme="garden">garden</button>
                                        <button type="button" class="bv-theme-option" data-theme="forest">forest</button>
                                        <button type="button" class="bv-theme-option" data-theme="aqua">aqua</button>
                                        <button type="button" class="bv-theme-option" data-theme="lofi">lofi</button>
                                        <button type="button" class="bv-theme-option" data-theme="pastel">pastel</button>
                                        <button type="button" class="bv-theme-option" data-theme="fantasy">fantasy</button>
                                        <button type="button" class="bv-theme-option" data-theme="wireframe">wireframe</button>
                                        <button type="button" class="bv-theme-option" data-theme="black">black</button>
                                        <button type="button" class="bv-theme-option" data-theme="luxury">luxury</button>
                                        <button type="button" class="bv-theme-option" data-theme="dracula">dracula</button>
                                        <button type="button" class="bv-theme-option" data-theme="cmyk">cmyk</button>
                                        <button type="button" class="bv-theme-option" data-theme="autumn">autumn</button>
                                        <button type="button" class="bv-theme-option" data-theme="business">business</button>
                                        <button type="button" class="bv-theme-option" data-theme="acid">acid</button>
                                        <button type="button" class="bv-theme-option" data-theme="lemonade">lemonade</button>
                                        <button type="button" class="bv-theme-option" data-theme="night">night</button>
                                        <button type="button" class="bv-theme-option" data-theme="coffee">coffee</button>
                                        <button type="button" class="bv-theme-option" data-theme="winter">winter</button>
                                        <button type="button" class="bv-theme-option" data-theme="dim">dim</button>
                                        <button type="button" class="bv-theme-option" data-theme="nord">nord</button>
                                        <button type="button" class="bv-theme-option" data-theme="sunset">sunset</button>
                                        <button type="button" class="bv-theme-option" data-theme="caramellatte">caramellatte</button>
                                        <button type="button" class="bv-theme-option" data-theme="abyss">abyss</button>
                                        <button type="button" class="bv-theme-option" data-theme="silk">silk</button>
                                        <button type="button" class="bv-theme-option" data-theme="bookvertex">BookVertex</button>
                                    </div>
                                </div>
                            </div>
                        </details>
                    </div>
                </div>
            </header>

            <main class="admin-main min-w-0 flex-1 bg-base-200 p-0 m-0">
                <partial name="_Notification" />
                @RenderBody()
            </main>
        </div>

        <!-- Sidebar -->
        <div class="drawer-side z-50">
            <label for="admin-drawer" class="drawer-overlay"></label>

            <aside class="flex min-h-full w-64 flex-col border-r border-base-300 bg-base-100">
                <div class="flex h-16 items-center border-b border-base-300 px-5">
                    <a asp-area="Customer" asp-controller="Home" asp-action="Index"
                       class="flex items-center gap-3">
                        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary text-primary-content shadow-sm">
                            <i class="bi bi-book"></i>
                        </div>
                        <div>
                            <div class="text-base font-extrabold tracking-tight">
                                Book<span class="text-primary">Vertex</span>
                            </div>
                            <div class="text-[9px] font-bold uppercase tracking-[0.18em] text-base-content/45">
                                Admin Portal
                            </div>
                        </div>
                    </a>
                </div>

                <nav class="flex-1 overflow-y-auto px-3 py-4">
                    <partial name="_AdminSidebarNav" />
                </nav>

                <div class="border-t border-base-300 p-3">
                    <div class="mb-3 flex items-center gap-3 rounded-xl bg-base-200 px-3 py-2.5">
                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                            <i class="bi bi-person-circle"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-xs font-semibold text-base-content">
                                @User.Identity?.Name
                            </p>
                            <p class="text-[10px] text-base-content/45">
                                Administrator
                            </p>
                        </div>
                    </div>

                    <div class="grid grid-cols-[1fr_auto] gap-2">
                        <a asp-area="Customer" asp-controller="Home" asp-action="Index"
                           class="btn btn-outline btn-sm gap-2">
                            <i class="bi bi-shop"></i>
                            Store
                        </a>

                        <form method="post"
                              asp-area="Identity"
                              asp-controller="Account"
                              asp-action="Logout">
                            <button type="submit"
                                    class="btn btn-error btn-outline btn-sm btn-square"
                                    title="Logout">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </aside>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script src="//cdn.datatables.net/2.3.7/js/dataTables.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>